      _id: { $concat: ["$nombre", " ", "$apellido"] },
      "total km": { $sum: "$kilometros" }
    }
  },
  {
    $sort: { "total km": -1 }
  },
  {
    $limit: 1
  }
])


db.corredores.aggregate([
  {
    $group: {
      _id: "$mes",
      "promedio km": { $avg: "$kilometros" }
    }
  },
  {
    $sort: { _id: 1 }
  }
])


