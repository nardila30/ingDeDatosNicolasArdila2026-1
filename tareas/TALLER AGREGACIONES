db.corredores.aggregate([
  {
    $group: {
      _id: { $concat: ["$nombre", " ", "$apellido"] },
      "total minutos": { $sum: "$minutos" },
      "total kilometros": { $sum: "$kilometros" }
    }
  }
])


db.corredores.aggregate([
  {
    $group: {
      _id: { $concat: ["$nombre", " ", "$apellido"] },
      "promedio minutos mensuales": { $avg: "$minutos" }
    }
  }
])


db.corredores.aggregate([
  {
    $group: {
      _id: { $concat: ["$nombre", " ", "$apellido"] },
      "promedio km mensuales": { $avg: "$kilometros" }
    }
  },
  {
    $match: { "promedio km mensuales": { $gt: 5 } }
  }
])


db.corredores.aggregate([
  {
    $group: {
      _id: {
        corredor: { $concat: ["$nombre", " ", "$apellido"] },
        mes: "$mes"
      },
      "total km": { $sum: "$kilometros" }
    }
  },
  {
    $sort: { "_id.mes": 1 }
  }
])


db.corredores.aggregate([
  {
    $group: {
      _id: { $concat: ["$nombre", " ", "$apellido"] },
      "distancias km": { $addToSet: "$kilometros" }
    }
  }
])


db.corredores.aggregate([
  {
    $unwind: "$aficiones"
  },
  {
    $group: {
      _id: "$aficiones",
      "total corredores": { $sum: 1 }
    }
  },
  {
    $sort: { "total corredores": -1 }
  }
])


db.corredores.aggregate([
